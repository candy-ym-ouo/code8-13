generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DELETED
}

enum BookStatus {
  TO_READ
  READING
  READ
  PAUSED
  ABANDONED
}

enum MoodTag {
  MOVED
  CALM
  JOYFUL
  SAD
  ANGRY
  CONFUSED
  RELIEVED
  EMPTY
  CHANGED
}

enum ActivityEntityType {
  BOOK
  DOG_EAR
  ANNOTATION
  REREAD_MARK
  COMPLETION_REFLECTION
  SHELF_LOCATION
  BOOK_COPY
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  RESTORED
  STATUS_CHANGED
  COMPLETED
  MOVED
  ARCHIVED
  UNARCHIVED
}

enum ShelfLocationStatus {
  ACTIVE
  ARCHIVED
}

enum BookCopyStatus {
  SHELVED
  ARCHIVED
}

enum CopyMoveAction {
  PLACED
  MOVED
  REMOVED
  ARCHIVED
  UNARCHIVED
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique @db.VarChar(320)
  passwordHash String      @map("password_hash")
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(3)

  sessions          Session[]
  books             Book[]
  dogEars           DogEar[]
  annotations       Annotation[]
  rereadMarks       RereadMark[]
  reflections       CompletionReflection[]
  activityEvents    ActivityEvent[]
  shelfLocations    ShelfLocation[]
  bookCopies        BookCopy[]
  copyLocationEvents CopyLocationEvent[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Book {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  version         Int        @default(1)
  title           String     @db.VarChar(300)
  author          String?    @db.VarChar(300)
  publisher       String?    @db.VarChar(300)
  publicationYear Int?       @map("publication_year") @db.SmallInt
  isbn            String?    @db.VarChar(20)
  pageCount       Int?       @map("page_count")
  coverUrl        String?    @map("cover_url")
  status          BookStatus @default(TO_READ)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  user          User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  dogEars       DogEar[]
  annotations   Annotation[]
  rereadMarks   RereadMark[]
  reflections   CompletionReflection[]
  activityEvents ActivityEvent[]
  copies        BookCopy[]
  copyLocationEvents CopyLocationEvent[]

  @@index([userId, deletedAt, updatedAt])
  @@index([userId, status])
  @@index([userId, title])
  @@map("books")
}

model ShelfLocation {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  name        String             @db.VarChar(200)
  description String?            @db.VarChar(1000)
  status      ShelfLocationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime?          @map("archived_at") @db.Timestamptz(3)

  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  copies           BookCopy[]          @relation("CurrentLocation")
  eventsFrom       CopyLocationEvent[] @relation("FromLocation")
  eventsTo         CopyLocationEvent[] @relation("ToLocation")

  @@index([userId, status, name])
  @@map("shelf_locations")
}

model BookCopy {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  bookId            String         @map("book_id") @db.Uuid
  copyNumber        Int            @map("copy_number")
  label             String?        @db.VarChar(300)
  condition         String?        @db.VarChar(100)
  acquiredAt        DateTime?      @map("acquired_at") @db.Timestamptz(3)
  notes             String?        @db.VarChar(5000)
  currentLocationId String?        @map("current_location_id") @db.Uuid
  status            BookCopyStatus @default(SHELVED)
  version           Int            @default(1)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(3)

  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  book            Book                @relation(fields: [bookId], references: [id], onDelete: Restrict)
  currentLocation ShelfLocation?      @relation("CurrentLocation", fields: [currentLocationId], references: [id], onDelete: Restrict)
  locationEvents  CopyLocationEvent[]

  @@unique([bookId, copyNumber])
  @@index([userId, deletedAt, updatedAt])
  @@index([bookId, deletedAt])
  @@index([currentLocationId, status, deletedAt])
  @@map("book_copies")
}

model CopyLocationEvent {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  copyId     String         @map("copy_id") @db.Uuid
  bookId     String         @map("book_id") @db.Uuid
  action     CopyMoveAction
  fromLocationId String?    @map("from_location_id") @db.Uuid
  toLocationId   String?    @map("to_location_id") @db.Uuid
  fromSnapshot   String?    @map("from_snapshot") @db.VarChar(200)
  toSnapshot     String?    @map("to_snapshot") @db.VarChar(200)
  note       String?        @db.VarChar(1000)
  occurredAt DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)

  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  copy         BookCopy       @relation(fields: [copyId], references: [id], onDelete: Restrict)
  book         Book           @relation(fields: [bookId], references: [id], onDelete: Restrict)
  fromLocation ShelfLocation? @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   ShelfLocation? @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)

  @@index([copyId, occurredAt])
  @@index([userId, occurredAt])
  @@index([bookId, occurredAt])
  @@map("copy_location_events")
}

model DogEar {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  bookId     String    @map("book_id") @db.Uuid
  version    Int       @default(1)
  pageNumber Int       @map("page_number")
  reason     String?   @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  book Book @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([userId, deletedAt, createdAt])
  @@index([bookId, pageNumber, deletedAt])
  @@map("dog_ears")
}

model Annotation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  bookId    String    @map("book_id") @db.Uuid
  version   Int       @default(1)
  startPage Int       @map("start_page")
  endPage   Int       @map("end_page")
  content   String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  book Book @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([userId, deletedAt, createdAt])
  @@index([bookId, startPage, endPage, deletedAt])
  @@map("annotations")
}

model RereadMark {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  bookId     String    @map("book_id") @db.Uuid
  version    Int       @default(1)
  pageNumber Int       @map("page_number")
  reason     String?   @db.VarChar(1000)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  book Book @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([userId, deletedAt, createdAt])
  @@index([bookId, pageNumber, deletedAt])
  @@map("reread_marks")
}

model CompletionReflection {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  bookId           String    @map("book_id") @db.Uuid
  version          Int       @default(1)
  completionRound  Int       @map("completion_round")
  moodTags         MoodTag[] @map("mood_tags")
  reflection       String?
  completedAt      DateTime  @map("completed_at") @db.Timestamptz(3)
  editableUntil    DateTime  @map("editable_until") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  book Book @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([userId, deletedAt, completedAt])
  @@index([bookId, completionRound, deletedAt])
  @@map("completion_reflections")
}

model ActivityEvent {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  bookId      String?            @map("book_id") @db.Uuid
  entityType  ActivityEntityType @map("entity_type")
  entityId    String?            @map("entity_id") @db.Uuid
  action      ActivityAction
  payloadJson Json               @default("{}") @map("payload_json")
  occurredAt  DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  book Book? @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
  @@index([userId, bookId, occurredAt])
  @@index([userId, entityType, occurredAt])
  @@map("activity_events")
}
